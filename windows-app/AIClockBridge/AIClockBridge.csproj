<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows bridge (status, now-playing, stocks, device controls).
       WinForms + WinRT media APIs. EnableWindowsTargeting lets the project
       compile on non-Windows hosts; the GUI itself only runs on Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AIClockBridge</AssemblyName>
    <RootNamespace>AIClockBridge</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\happy-mac.png" />
  </ItemGroup>

</Project>
